# Exemplo de variaveis locais - jus9-tecnologia-juridica
# Copie para .env apenas no ambiente local, se necessario.
# Nunca publique .env real.

OPENAI_API_KEY="coloque_sua_chave_apenas_no_ambiente_seguro"
JUS9_CONTACT_EMAIL="Contato@jus9tecnologia.com.br"

# Login Google real do MVP
# Configure valores reais apenas no provedor seguro de deploy.
PUBLIC_SITE_ORIGIN="https://www.jus9tecnologia.com.br"
GOOGLE_CLIENT_ID="insira-o-client-id-google"
GOOGLE_CLIENT_SECRET="insira-o-client-secret-apenas-no-ambiente-seguro"
GOOGLE_CALLBACK_URL="https://www.jus9tecnologia.com.br/auth/google/callback"
AUTH_COOKIE_SECRET="gere-uma-chave-longa-fora-do-github"

# Acesso Google governado
# AUTH_PUBLIC_GOOGLE_ENABLED=true permite login de qualquer Conta Google verificada.
# Nesta fase o unico perfil publico aceito e cidadao.
AUTH_PUBLIC_GOOGLE_ENABLED="false"
AUTH_PUBLIC_GOOGLE_PROFILE="cidadao"
AUTH_ALLOWED_EMAILS="email-autorizado@dominio.com:admin_sistema,outro-email@dominio.com:advogado"

# Segredo compartilhado somente entre o proxy do portal e a API Charlie Echo.
# Autoriza efeitos no Drive apenas quando a sessao possui drive:write.
JUS9_CHARLIE_INTERNAL_TOKEN="gere-um-token-interno-longo-e-use-o-mesmo-na-api-charlie"

# Calendar Producao 1B
# Mantenha false ate a verificacao sensivel e a confirmacao operacional final.
GOOGLE_CALENDAR_OAUTH_ENABLED="false"

# CNJ/DataJud - Gateway de tribunais em modo leitura
# Configure no provedor seguro. Nunca publique chave real.
JUS9_TRIBUNAIS_GATEWAY_TOKEN="gere-um-token-interno-longo"
DATAJUD_API_KEY="chave-publica-datajud-no-provedor-seguro"
# Alternativa legada, se o ambiente DataJud exigir Basic Auth:
DATAJUD_USERNAME=""
DATAJUD_PASSWORD=""
DATAJUD_TIMEOUT_MS="12000"
DATAJUD_RATE_PER_MINUTE="120"

# PDPJ-Br - somente readiness e teste OAuth2 nesta fase.
# Nao habilita MNI, Domicilio, peticionamento ou ciencia processual.
PDPJ_ENVIRONMENT="homologacao"
PDPJ_TOKEN_URL="https://endpoint-oficial-autorizado/token"
PDPJ_CLIENT_ID=""
PDPJ_CLIENT_SECRET=""
PDPJ_SCOPE=""
PDPJ_TIMEOUT_MS="10000"

AUTH_SUCCESS_REDIRECT="https://www.jus9tecnologia.com.br/app.html"
AUTH_ENFORCE_API="false"
