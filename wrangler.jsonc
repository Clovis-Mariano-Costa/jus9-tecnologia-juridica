{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jus9-tecnologia-juridica",
  "main": "worker.js",
  "compatibility_date": "2026-05-23",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": {
    "AUTH_PUBLIC_GOOGLE_ENABLED": "true",
    "AUTH_PUBLIC_GOOGLE_PROFILE": "cidadao"
  },
  "kv_namespaces": [
    {
      "binding": "JUS9_CALENDAR_TOKENS",
      "id": "8da90de2fb9a47e8a1f9e5c322eff746"
    },
    {
      "binding": "JUS9_PROFILE_REQUESTS",
      "id": "016bf81fce5242c7aacc42e5a1a50bf3"
    }
  ]
}
